msgid "Vietnam Store Toolkit for WooCommerce: scan data from Le Van Toan plugins"
msgstr "Vietnam Store Toolkit for WooCommerce: quét dữ liệu từ plugin của Le Van Toan"

msgid "Scan data"
msgstr "Quét dữ liệu"

msgid "Scan order addresses and shipment data created by Le Van Toan plugins without changing any order data. Use this before running the sync."
msgstr "Quét địa chỉ đơn hàng và dữ liệu vận đơn được tạo bởi plugin của Le Van Toan mà không thay đổi dữ liệu đơn hàng. Hãy chạy bước này trước khi đồng bộ."

msgid "Vietnam Store Toolkit for WooCommerce: sync data from Le Van Toan plugins"
msgstr "Vietnam Store Toolkit for WooCommerce: đồng bộ dữ liệu từ plugin của Le Van Toan"

msgid "Sync batch"
msgstr "Đồng bộ một phần"

#, php-format
msgid "Sync up to %d safe address rows and shipment data from Le Van Toan plugins into Vietnam Store Toolkit for WooCommerce data. Address values are backed up before changes are saved."
msgstr "Đồng bộ tối đa %d dòng địa chỉ an toàn và dữ liệu vận đơn từ plugin của Le Van Toan vào dữ liệu của Vietnam Store Toolkit for WooCommerce. Giá trị địa chỉ cũ sẽ được sao lưu trước khi lưu thay đổi."

msgid "You do not have permission to run this tool."
msgstr "Bạn không có quyền chạy công cụ này."

msgid "Security check failed. Please reload the page and try again."
msgstr "Kiểm tra bảo mật thất bại. Vui lòng tải lại trang và thử lại."

#, php-format
msgid "Order #%d could not be loaded."
msgstr "Không thể tải đơn hàng #%d."

msgid "Billing"
msgstr "Thanh toán"

msgid "Shipping"
msgstr "Giao hàng"

#, php-format
msgid "Le Van Toan plugin data scan complete. Address rows: %1$d total (%4$d billing, %5$d shipping). Safe sync: %2$d address rows across %6$d orders (%9$d old three-level rows, %10$d new two-level rows). Needs official mapping/manual review: %3$d address rows. Shipment orders: %7$d total; %8$d still need normalized VCK shipment data."
msgstr "Đã quét dữ liệu từ plugin của Le Van Toan. Địa chỉ: tổng %1$d dòng (%4$d thanh toán, %5$d giao hàng). Có thể đồng bộ an toàn: %2$d dòng địa chỉ trên %6$d đơn hàng (%9$d dòng cấu trúc 3 cấp cũ, %10$d dòng cấu trúc 2 cấp mới). Cần đối chiếu chính thức hoặc kiểm tra thủ công: %3$d dòng địa chỉ. Đơn hàng có vận đơn: tổng %7$d; còn %8$d đơn hàng cần dữ liệu vận đơn chuẩn của Vietnam Store Toolkit for WooCommerce."

#, php-format
msgid "Review samples: %s."
msgstr "Mẫu cần kiểm tra: %s."

#, php-format
msgid "Le Van Toan plugin data sync batch complete. Updated %1$d orders and synced %2$d address rows. Synced %3$d shipment orders. Remaining safe address rows: %4$d. Remaining address rows needing mapping/manual review: %5$d."
msgstr "Đã đồng bộ xong một phần dữ liệu từ plugin của Le Van Toan. Đã cập nhật %1$d đơn hàng và đồng bộ %2$d dòng địa chỉ. Đã đồng bộ %3$d đơn hàng có vận đơn. Còn %4$d dòng địa chỉ có thể đồng bộ an toàn. Còn %5$d dòng địa chỉ cần đối chiếu hoặc kiểm tra thủ công."

#, php-format
msgid "Errors: %s"
msgstr "Lỗi: %s"

msgid "Sync all"
msgstr "Đồng bộ tất cả"

#, php-format
msgid "Sync all safe address rows and shipment data created by Le Van Toan plugins into Vietnam Store Toolkit for WooCommerce data. The browser will process the sync in chunks of up to %d address rows. Address values are backed up before changes are saved."
msgstr "Đồng bộ toàn bộ các dòng địa chỉ an toàn và dữ liệu vận đơn được tạo bởi plugin của Le Van Toan vào dữ liệu của Vietnam Store Toolkit for WooCommerce. Trình duyệt sẽ xử lý theo từng phần, tối đa %d dòng địa chỉ mỗi phần. Giá trị địa chỉ cũ sẽ được sao lưu trước khi lưu thay đổi."

msgid "Preparing sync..."
msgstr "Đang chuẩn bị đồng bộ..."

msgid "Syncing..."
msgstr "Đang đồng bộ..."

msgid "Sync completed."
msgstr "Đã hoàn tất đồng bộ."

msgid "No safe data from Le Van Toan plugins is available to sync."
msgstr "Không có dữ liệu an toàn nào từ plugin của Le Van Toan để đồng bộ."

msgid "Sync stopped because no progress was made in the latest step. Please run the scan tool and review the remaining data."
msgstr "Đồng bộ đã dừng vì bước gần nhất không có tiến trình mới. Vui lòng chạy công cụ quét và kiểm tra dữ liệu còn lại."

msgid "Sync request failed. Please try again."
msgstr "Yêu cầu đồng bộ thất bại. Vui lòng thử lại."

msgid "This will sync all safe data from Le Van Toan plugins in the background. Continue?"
msgstr "Thao tác này sẽ đồng bộ toàn bộ dữ liệu an toàn từ plugin của Le Van Toan ở nền. Tiếp tục?"

msgid "address rows"
msgstr "dòng địa chỉ"

msgid "shipment orders"
msgstr "đơn hàng có vận đơn"

msgid "All safe data from Le Van Toan plugins has been synced. Any remaining address rows require official mapping or manual review."
msgstr "Toàn bộ dữ liệu an toàn từ plugin của Le Van Toan đã được đồng bộ. Các dòng địa chỉ còn lại cần đối chiếu chính thức hoặc kiểm tra thủ công."

#, php-format
msgid "Remaining: %1$d safe address rows, %2$d shipment orders. Manual review still needed for %3$d address rows."
msgstr "Còn lại: %1$d dòng địa chỉ an toàn, %2$d đơn hàng có vận đơn. Vẫn cần kiểm tra thủ công cho %3$d dòng địa chỉ."

msgid "Vietnam Store Toolkit for WooCommerce detected active plugins from Le Van Toan."
msgstr "Vietnam Store Toolkit for WooCommerce phát hiện plugin của Le Van Toan đang hoạt động."

#, php-format
msgid "Detected: %s."
msgstr "Đã phát hiện: %s."

msgid "These plugins can also modify WooCommerce Vietnam address and checkout fields. Run the scan and sync tools before disabling the old plugin to avoid city/province, ward/commune, city, state, and address line 2 data conflicts."
msgstr "Các plugin này cũng có thể thay đổi các trường địa chỉ và checkout dành cho Việt Nam trong WooCommerce. Hãy chạy công cụ quét và đồng bộ trước khi tắt plugin cũ để tránh xung đột dữ liệu Thành phố/Tỉnh, Phường/Xã, city, state và địa chỉ dòng 2."

msgid "Open sync tools"
msgstr "Mở công cụ đồng bộ"

msgid "I have handled this"
msgstr "Tôi đã xử lý"

msgid "Vietnam Store Toolkit for WooCommerce detected an active Le Van Toan plugin. Both plugins may modify city/province and ward/commune checkout fields, which can cause city, state, address line 2, or admin/frontend display conflicts."
msgstr "Vietnam Store Toolkit for WooCommerce phát hiện plugin của Le Van Toan đang hoạt động. Cả hai plugin đều có thể thay đổi trường Thành phố/Tỉnh và Phường/Xã ở checkout, có thể gây xung đột city, state, địa chỉ dòng 2 hoặc hiển thị giữa admin và frontend."

