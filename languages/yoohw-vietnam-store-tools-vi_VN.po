msgid "A WooCommerce toolkit for Vietnam-focused commerce workflows."
msgstr "Bộ công cụ WooCommerce cho các quy trình thương mại tại Việt Nam."

msgid "Amount"
msgstr "Số tiền"

msgid "Account holder"
msgstr "Chủ tài khoản"

msgid "City / Province"
msgstr "Thành phố / Tỉnh"

msgid "Bank BIN"
msgstr "Mã BIN ngân hàng"

msgid "Bank BIN is required to generate VietQR codes."
msgstr "Cần nhập Mã BIN ngân hàng để tạo mã VietQR."

msgid "Choose a bank in each bank transfer account to generate VietQR payment QR codes for Vietnamese bank transfers. Existing legacy Bank BIN and Sort code values are still supported."
msgstr "Chọn ngân hàng trong từng tài khoản chuyển khoản để tạo mã QR VietQR cho chuyển khoản ngân hàng tại Việt Nam. Các giá trị Mã BIN ngân hàng và Sort code cũ vẫn được hỗ trợ."

msgid "Choose the receiving bank. The VietQR bank BIN will be filled automatically."
msgstr "Chọn ngân hàng nhận tiền. Mã BIN VietQR sẽ được tự động điền."

msgid "Compact"
msgstr "Gọn"

msgid "Compact with VietQR logo"
msgstr "Gọn kèm logo VietQR"

msgid "Full name"
msgstr "Họ và tên"

msgid "Copied"
msgstr "Đã sao chép"

msgid "Copy account number"
msgstr "Sao chép số tài khoản"

msgid "Copy transfer content"
msgstr "Sao chép nội dung chuyển khoản"

msgid "Could not save the VietQR transfer content template."
msgstr "Không thể lưu mẫu nội dung chuyển khoản VietQR."

msgid "Email display"
msgstr "Hiển thị trong email"

msgid "Enter the VietQR/NAPAS bank BIN for this Vietnam bank account, for example 970436."
msgstr "Nhập Mã BIN VietQR/NAPAS cho tài khoản ngân hàng Việt Nam này, ví dụ 970436."

msgid "Include the order amount in the QR code when the order currency is VND"
msgstr "Thêm số tiền đơn hàng vào mã QR khi tiền tệ của đơn là VND"

msgid "Not included in QR code"
msgstr "Không kèm trong mã QR"

msgid "Pay by bank transfer"
msgstr "Thanh toán chuyển khoản"

msgid "Pay by VietQR bank transfer"
msgstr "Thanh toán chuyển khoản VietQR"

msgid "QR code"
msgstr "Mã QR"

msgid "QR only"
msgstr "Chỉ mã QR"

msgid "QR template"
msgstr "Mẫu QR"

msgid "Show VietQR code for direct bank transfer orders"
msgstr "Hiển thị mã VietQR cho đơn thanh toán chuyển khoản ngân hàng"

msgid "Show VietQR code in customer bank transfer emails"
msgstr "Hiển thị mã VietQR trong email chuyển khoản gửi khách hàng"

msgid "Please select a bank to generate VietQR codes."
msgstr "Vui lòng chọn ngân hàng để tạo mã VietQR."

msgid "Select a bank"
msgstr "Chọn ngân hàng"

msgid "Transfer content"
msgstr "Nội dung chuyển khoản"

msgid "Transfer content template"
msgstr "Mẫu nội dung chuyển khoản"

msgid "Transfer note"
msgstr "Nội dung"

msgid "VietQR"
msgstr "VietQR"

msgid "VietQR bank transfer"
msgstr "Chuyển khoản VietQR"

msgid "Vietnam Store Toolkit for WooCommerce uses Vietnam bank transfer accounts for VietQR."
msgstr "Vietnam Store Toolkit for WooCommerce sử dụng tài khoản chuyển khoản ngân hàng Việt Nam cho VietQR."

msgid "VietQR payment QR"
msgstr "Mã QR thanh toán VietQR"

msgid "VietQR payment QR code"
msgstr "Mã QR thanh toán VietQR"

msgid "Available placeholders: {order_id}, {order_number}, {site_name}."
msgstr "Biến có thể dùng: {order_id}, {order_number}, {site_name}."

msgid "Allow customers to request a VAT invoice during checkout."
msgstr "Cho phép khách hàng yêu cầu xuất hóa đơn VAT trong quá trình thanh toán."

msgid "Company address"
msgstr "Địa chỉ đơn vị"

msgid "Company legal name"
msgstr "Tên đơn vị"

msgid "Invoice recipient email"
msgstr "Email nhận hóa đơn"

msgid "Please enter a valid invoice recipient email."
msgstr "Vui lòng nhập email nhận hóa đơn hợp lệ."

msgid "Please enter a valid Vietnamese tax code."
msgstr "Vui lòng nhập mã số thuế Việt Nam hợp lệ."

msgid "Please enter the company address for the tax invoice."
msgstr "Vui lòng nhập địa chỉ đơn vị để xuất hóa đơn."

msgid "Please enter the company legal name for the tax invoice."
msgstr "Vui lòng nhập tên đơn vị để xuất hóa đơn."

msgid "Please enter the invoice recipient email."
msgstr "Vui lòng nhập email nhận hóa đơn."

msgid "Please enter the tax code for the tax invoice."
msgstr "Vui lòng nhập mã số thuế để xuất hóa đơn."

msgid "Please enter a valid Vietnamese phone number."
msgstr "Vui lòng nhập số điện thoại Việt Nam hợp lệ."

msgid "Please select a valid city / province."
msgstr "Vui lòng chọn thành phố / tỉnh hợp lệ."

msgid "Please select a valid ward / commune for the selected city / province."
msgstr "Vui lòng chọn phường / xã hợp lệ cho thành phố / tỉnh đã chọn."

msgid "Requested"
msgstr "Đã yêu cầu"

msgid "Request a VAT invoice"
msgstr "Yêu cầu xuất hóa đơn VAT"

msgid "Tax code"
msgstr "Mã số thuế"

msgid "Tax invoice information"
msgstr "Thông tin xuất hóa đơn"

msgid "Tax invoice request"
msgstr "Yêu cầu xuất hóa đơn"

msgid "Vietnam tax invoice requests"
msgstr "Yêu cầu hóa đơn thuế"

